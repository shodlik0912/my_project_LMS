
<!DOCTYPE html>
<html lang="uz">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Colorful Web Server</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg,
        #090979, #6500b5, #ff0080, #ff8c00);
    background-size: 400% 400%;
    animation: gradient 10s ease infinite;
    min-height: 100vh;
    color: white;
}

@keyframes gradient {
    0% {background-position: 0% 50%;}
    50% {background-position: 100% 50%;}
    100% {background-position: 0% 50%;}
}

header {
    padding: 25px;
    text-align: center;
    background: #00000055;
    backdrop-filter: blur(15px);
}

header h1 {
    font-size: 35px;
    color: #00ffff;
    text-shadow: 0 0 15px cyan;
}

.container {
    max-width: 1100px;
    margin: 40px auto;
    padding: 20px;
}

.welcome {
    text-align: center;
    margin-bottom: 35px;
}

.welcome h2 {
    font-size: 32px;
    color: #ffff00;
    text-shadow: 0 0 15px yellow;
}

.cards {
    display: grid;
    grid-template-columns:
        repeat(auto-fit, minmax(220px, 1fr));
    gap: 25px;
}

.card {
    padding: 30px;
    border-radius: 20px;
    text-align: center;
    background: #ffffff22;
    border: 2px solid #ffffff66;
    backdrop-filter: blur(15px);
    transition: 0.4s;
    box-shadow: 0 0 20px #00000055;
}

.card:hover {
    transform: translateY(-12px) scale(1.04);
    box-shadow: 0 0 30px cyan;
}

.card h3 {
    color: #00ffff;
    margin-bottom: 15px;
    font-size: 24px;
}

.card p {
    font-size: 17px;
    color: #fff;
}

.icon {
    font-size: 50px;
    margin-bottom: 15px;
}

.status {
    color: #00ff66 !important;
    font-weight: bold;
}

button {
    margin-top: 30px;
    padding: 15px 35px;
    border: none;
    border-radius: 30px;
    background: linear-gradient(90deg,
        #00ffff, #ff00ff, #ffff00);
    color: #111;
    font-weight: bold;
    font-size: 17px;
    cursor: pointer;
    transition: 0.3s;
}

button:hover {
    transform: scale(1.1);
    box-shadow: 0 0 25px cyan;
}

footer {
    text-align: center;
    padding: 25px;
    background: #00000055;
    margin-top: 50px;
    color: #fff;
}
</style>
</head>

<body>

<header>
    <h1>🌈 MY WEB SERVER 🌈</h1>
    <p>Colorful Server Dashboard</p>
</header>

<div class="container">

    <div class="welcome">
        <h2>🚀 Xush kelibsiz!</h2>
        <p>Bizning zamonaviy Web Server tizimimizga xush kelibsiz.</p>
    </div>

    <div class="cards">

        <div class="card">
            <div class="icon">🖥️</div>
            <h3>SERVER</h3>
            <p class="status">● ONLINE</p>
        </div>

        <div class="card">
            <div class="icon">🌐</div>
            <h3>NETWORK</h3>
            <p>Network faol</p>
        </div>

        <div class="card">
            <div class="icon">⚡</div>
            <h3>SPEED</h3>
            <p>Fast Connection</p>
        </div>

        <div class="card">
            <div class="icon">🔒</div>
            <h3>SECURITY</h3>
            <p>Protection Enabled</p>
        </div>

    </div>

    <center>
        <button onclick="showMessage()">
            SERVER STATUS
        </button>
    </center>

</div>

<footer>
    🌈 © 2026 MY COLORFUL WEB SERVER 🌈
</footer>

<script>
function showMessage() {
    alert("✅ Web Server Dashboard ishlayapti!");
}
</script>

</body>
</html>

